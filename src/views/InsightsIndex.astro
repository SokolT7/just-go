---
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import berislavPhoto from '@/assets/images/people/berislav-portrait.jpg';
import { articlePath, type Locale } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getCollection('insights', (e) => e.id.startsWith(`${locale}/`));
const posts = all.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const copy = {
  en: {
    metaTitle: 'Insights — Sales, Partnerships & Go-to-Market | Just Go',
    metaDesc:
      'Notes on qualification, sponsorship renewals and why stalled growth is usually an execution problem rather than a strategy problem. Written by Berislav Sokač.',
    eyebrow: 'Insights',
    h1: 'Notes from the work',
    lede:
      'Short, specific pieces on the things that actually decide whether a deal closes. No frameworks, no listicles — just what twenty-five years of doing this has made obvious.',
  },
  hr: {
    metaTitle: 'Članci — prodaja, partnerstva i izlazak na tržište | Just Go',
    metaDesc:
      'Bilješke o kvalifikaciji, obnovi sponzorstava i zašto je zaustavljen rast obično problem izvedbe, a ne strategije. Piše Berislav Sokač.',
    eyebrow: 'Članci',
    h1: 'Bilješke s terena',
    lede:
      'Kratki, konkretni tekstovi o onome što stvarno odlučuje hoće li se posao zatvoriti. Bez okvira i bez lista — samo ono što je dvadeset pet godina prakse učinilo očitim.',
  },
}[locale];

const dateFmt = new Intl.DateTimeFormat(locale === 'hr' ? 'hr-HR' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<Base title={copy.metaTitle} description={copy.metaDesc} locale={locale} routeKey="insights">
  <section class="bg-navy text-snow">
    <div class="wrap pt-16 pb-14 sm:pt-20 sm:pb-16">
      <p class="eyebrow text-horizon mb-5">{copy.eyebrow}</p>
      <h1 class="text-display-l text-snow max-w-[16ch]">{copy.h1}</h1>
      <p class="mt-6 text-body-l text-mist max-w-[56ch]">{copy.lede}</p>
    </div>
  </section>

  <section class="bg-snow">
    <div class="wrap section-y">
      <ul class="border-t border-rule max-w-[62rem]">
        {
          posts.map((post) => {
            const slug = post.id.replace(`${locale}/`, '');
            return (
              <li class="border-b border-rule">
                <a
                  href={articlePath(slug, locale)}
                  class="group grid gap-4 py-8 sm:grid-cols-[9rem_1fr] sm:gap-10 focus-visible:outline-horizon"
                >
                  <div class="flex items-center gap-3 sm:block sm:pt-1.5">
                    <Image
                      src={berislavPhoto}
                      alt=""
                      widths={[36, 72, 108]}
                      sizes="36px"
                      loading="lazy"
                      decoding="async"
                      format="avif"
                      quality={82}
                      width={36}
                      height={36}
                      class="h-9 w-9 shrink-0 rounded-full object-cover bg-ridge sm:mb-3"
                    />
                    <p class="font-mono text-label uppercase tracking-[0.1em] text-ink-soft leading-relaxed">
                      <span class="text-navy">{post.data.author}</span>
                      <span class="hidden sm:block">
                        <time datetime={post.data.publishDate.toISOString()}>
                          {dateFmt.format(post.data.publishDate)}
                        </time>
                      </span>
                      <span class="sm:hidden">
                        {' · '}
                        <time datetime={post.data.publishDate.toISOString()}>
                          {dateFmt.format(post.data.publishDate)}
                        </time>
                      </span>
                    </p>
                  </div>
                  <div>
                    <h2 class="font-display font-bold text-[1.4rem] leading-[1.22] tracking-[-0.02em] text-navy text-balance group-hover:text-horizon-text transition-colors">
                      {post.data.title}
                    </h2>
                    <p class="mt-3 text-body text-ink-soft max-w-[58ch]">{post.data.description}</p>
                    <span class="mt-4 inline-flex items-center gap-1.5 font-display text-[0.9rem] font-semibold text-horizon-text group-hover:gap-2.5 transition-all">
                      {t('cta.readMore')}
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
