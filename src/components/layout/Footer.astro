---
import { NAV_KEYS, path, type Locale, type RouteKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const navLabel: Record<string, string> = {
  services: t('nav.services'),
  about: t('nav.about'),
  team: t('nav.team'),
  mission: t('nav.mission'),
  clients: t('nav.clients'),
  insights: t('nav.insights'),
};

const elsewhere = [
  { label: 'Berislav on LinkedIn', href: 'https://www.linkedin.com/in/berislavsokac/' },
  { label: 'Odin on LinkedIn', href: 'https://www.linkedin.com/in/odin-sokac-00353a411/' },
  { label: 'odins.show', href: 'https://odin-s.vercel.app/' },
  { label: 'Run Croatia', href: 'http://runcroatia.hr/' },
];
---

<footer class="bg-navy-deep text-mist">
  <div class="wrap section-y-sm">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr] md:gap-12 lg:gap-16">
      <div>
        <p class="font-display font-bold text-[1.3rem] tracking-[-0.03em] text-snow">Just Go</p>
        <div class="mt-3 h-[2px] w-8 bg-horizon" aria-hidden="true"></div>
        <p class="mt-4 max-w-[34ch] text-small text-mist">{t('footer.tagline')}</p>
        <p class="mt-5 font-mono text-label uppercase tracking-[0.12em] text-mist/80">
          {t('footer.based')}
        </p>
      </div>

      <nav aria-label={t('footer.nav')}>
        <h2 class="eyebrow text-mist/80 mb-4">{t('footer.nav')}</h2>
        <ul class="space-y-2.5">
          {
            NAV_KEYS.map((key: RouteKey) => (
              <li>
                <a href={path(key, locale)} class="text-small text-mist hover:text-snow transition-colors">
                  {navLabel[key]}
                </a>
              </li>
            ))
          }
          <li>
            <a href={path('contact', locale)} class="text-small text-mist hover:text-snow transition-colors">
              {t('nav.contact')}
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow text-mist/80 mb-4">{t('footer.elsewhere')}</h2>
        <ul class="space-y-2.5">
          {
            elsewhere.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel="noopener me"
                  class="text-small text-mist hover:text-snow transition-colors inline-flex items-center gap-1.5"
                >
                  {link.label}
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="opacity-50">
                    <path d="M3 9L9 3M9 3H4M9 3v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
        <h2 class="eyebrow text-mist/80 mt-8 mb-3">{t('footer.contact')}</h2>
        <a
          href="mailto:bero.sokac@gmail.com"
          class="text-small text-snow hover:text-horizon transition-colors break-all"
        >
          bero.sokac@gmail.com
        </a>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/8 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
      <p class="font-mono text-label uppercase tracking-[0.1em] text-mist/80">
        © {year} Just Go. {t('footer.rights')}
      </p>
      <div class="sm:ml-auto flex gap-5">
        <a href={path('privacy', locale)} class="font-mono text-label uppercase tracking-[0.1em] text-mist/80 hover:text-snow transition-colors">
          {t('nav.privacy')}
        </a>
        <a href={path('terms', locale)} class="font-mono text-label uppercase tracking-[0.1em] text-mist/80 hover:text-snow transition-colors">
          {t('nav.terms')}
        </a>
      </div>
    </div>
  </div>
</footer>
