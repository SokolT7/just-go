---
import { logos, hasLogos } from '@/data/proof';
import type { Locale } from '@/i18n/routes';

interface Props { locale: Locale; tone?: 'light' | 'dark'; class?: string; }
const { locale, tone = 'light', class: className = '' } = Astro.props;

/*
  A single line of firms, marks only — no names, no dates. Each mark links out
  to the firm's own site, in a new tab so the visitor keeps their place here.

  Two things make a row of borrowed artwork read as one design rather than as
  twelve pasted files:

  1. ONE INK. `brightness(0)` collapses every pixel to black while leaving alpha
     alone, so it works the same on an SVG or a PNG, and — the reason it is here
     rather than `grayscale()` — it rescues the marks that ship only in a
     reversed cut. Several of these firms publish a white-on-transparent lockup
     for a dark header; under `grayscale()` those stay white and vanish on this
     page. Flattened, they come back. Opacity then sets the row's weight, which
     is quiet by default because this band sits under the numbers and should not
     outrank them. A mark whose design depends on a knockout opts out via
     `flatten: false` and supplies its own dark file.

  2. ONE OPTICAL SIZE. Marks are normalised to a height rather than a width —
     otherwise they will not share a baseline — and each carries a `scale` that
     corrects for how big it actually reads at that height. See src/data/proof.ts.

  The row is a fixed number of equal columns per width, not a free-wrapping
  line. Left to size themselves, marks of thirteen different widths break
  wherever they happen to run out of room, and a stray short line reads as a
  mistake. Thirteen divides by nothing, so instead the counts are picked to
  leave a short row that is clearly deliberate — 7+6 at desktop, 5+5+3 at
  tablet — and that row is centred under the full ones. Phones take two
  columns with the last mark centred alone. Adding or removing a firm means
  re-checking the counts in the style block; they are the one thing here
  that is tied to how many there are.

  An entry with no artwork falls back to a wordmark in our own display face, so
  a firm can be added before its logo turns up without leaving a hole.

  The band's own padding lives here rather than in each caller. When it was the
  caller's job, the home page had it and the contact page did not, and the row
  sat flush against the section edge looking sliced off.
*/
const label = {
  en: 'Where the experience was earned',
  hr: 'Gdje je iskustvo stečeno',
}[locale];

const dark = tone === 'dark';
const labelCls = dark ? 'text-mist' : 'text-ink-soft';
const markCls = dark ? 'text-mist-light' : 'text-navy';
/* On navy the flattening has to go the other way — to white, not to black. */
const flatFilter = dark ? 'brightness(0) invert(1)' : 'brightness(0)';
const BASE_H = 1.75; /* rem, the wordmark baseline height */
---

{
  hasLogos && (
    <div class={`px-5 py-10 sm:px-8 sm:py-12 ${className}`}>
      <p class={`eyebrow text-center ${labelCls}`}>{label}</p>

      <ul class="logo-row mt-8 flex flex-wrap justify-center items-center">
        {logos.map((logo) => {
          const Tag = logo.href ? 'a' : 'span';
          const link = logo.href
            ? { href: logo.href, target: '_blank', rel: 'noopener noreferrer' }
            : {};
          return (
            <li class="logo-cell flex items-center justify-center">
              <Tag {...link} class="logo-link flex items-center justify-center max-w-full">
                {logo.src ? (
                  <img
                    src={logo.src}
                    alt={logo.alt ?? logo.name}
                    loading="lazy"
                    decoding="async"
                    class="logo-mark w-auto max-w-full"
                    style={`height:${(BASE_H * (logo.scale ?? 1)).toFixed(3)}rem;${
                      logo.flatten === false ? '' : `filter:${flatFilter}`
                    }`}
                  />
                ) : (
                  <span
                    class={`logo-mark font-display font-semibold text-[0.95rem] sm:text-[1.05rem] leading-none tracking-[-0.015em] ${markCls}`}
                  >
                    {logo.name}
                  </span>
                )}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<style>
  /* Opacity lives here rather than in a utility because it is the one value
     tuned against the band as a whole, and because the hover and the
     reduced-motion opt-out both need to reach it. */
  .logo-mark {
    opacity: 0.58;
    transition: opacity 200ms ease;
  }

  .logo-row:hover .logo-mark {
    opacity: 0.4;
  }

  .logo-row .logo-mark:hover,
  .logo-row .logo-link:focus-visible .logo-mark {
    opacity: 1;
  }

  .logo-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
    border-radius: 2px;
  }

  /* Column counts — see the note in the frontmatter. Each cell is an exact
     1/n of the row less its share of the gaps, so a short last row centres
     under the full ones instead of stretching. */
  .logo-row {
    --cols: 2;
    --gap-x: 1.5rem;
    gap: 2rem var(--gap-x);
  }

  .logo-cell {
    width: calc((100% - (var(--cols) - 1) * var(--gap-x)) / var(--cols));
  }

  @media (min-width: 40rem) {
    .logo-row {
      --cols: 5;
      --gap-x: 2rem;
      gap: 2.25rem var(--gap-x);
    }
  }

  @media (min-width: 64rem) {
    .logo-row {
      --cols: 7;
    }
  }

  /* Pointer-only: on touch there is no hover, and dimming the row on first
     contact would read as a fault rather than as emphasis. */
  @media (hover: none) {
    .logo-row:hover .logo-mark,
    .logo-row .logo-mark:hover {
      opacity: 0.58;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-mark {
      transition: none;
    }
  }
</style>
