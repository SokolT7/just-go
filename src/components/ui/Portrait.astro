---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Shown when no photograph exists for this person yet. */
  initials: string;
  /** Rendered edge length in px; also drives the requested widths. */
  size?: number;
  /** Tailwind background class for the initials fallback. */
  tone?: string;
  /** object-position, to keep a face out of the crop's dead zone. */
  position?: string;
  class?: string;
}

const {
  image,
  alt = '',
  initials,
  size = 96,
  tone = 'bg-navy',
  position = '50% 35%',
  class: className = '',
} = Astro.props;

/*
  Fallback-aware, same principle as the proof components: a person without a
  photograph gets a considered initials tile rather than a broken image or a
  grey silhouette. Adding a photo later is a one-line prop change.
*/
const widths = [size, size * 2, size * 3];
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={`${size}px`}
      loading="lazy"
      decoding="async"
      format="avif"
      quality={80}
      style={`object-position:${position}`}
      class={`object-cover bg-ridge ${className}`}
      width={size}
      height={size}
    />
  ) : (
    <div
      class={`grid place-items-center text-snow font-display font-bold tracking-[-0.02em] ${tone} ${className}`}
      style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.24)}px`}
      aria-hidden="true"
    >
      {initials}
    </div>
  )
}
