---
import type { Locale } from '@/i18n/routes';

export interface FaqItem { q: string; a: string; }

interface Props {
  items: FaqItem[];
  locale: Locale;
  title?: string;
  class?: string;
}
const { items, title, class: className = '' } = Astro.props;

/*
  Answers are written as complete standalone statements — this is the block
  Google uses for People Also Ask, featured snippets and AI Overviews (PLAN §9).
  The FAQPage schema is emitted by the page that renders this, from the same
  array, so the markup and the structured data cannot drift apart.
*/
---

<div class={className}>
  {title && <h2 class="text-h2 text-navy mb-8">{title}</h2>}
  <dl class="border-t border-rule">
    {
      items.map((item) => (
        <details class="group border-b border-rule">
          <summary
            class="flex cursor-pointer items-start justify-between gap-6 py-5 list-none [&::-webkit-details-marker]:hidden"
          >
            <dt class="font-display font-semibold text-[1.05rem] text-navy text-balance">
              {item.q}
            </dt>
            <span
              class="shrink-0 mt-1 text-horizon-text transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            </span>
          </summary>
          <dd class="pb-6 pr-10 text-body text-ink-soft max-w-[62ch]">{item.a}</dd>
        </details>
      ))
    }
  </dl>
</div>
