---
import { milestones } from '@/data/milestones';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/routes';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);

const copy = {
  en: {
    title: 'Two lives, one dated axis',
    lede: 'Where the two of them came from, in order. Both are stories about starting before you feel ready — which is where the firm got its name.',
    who: { berislav: 'Berislav', odin: 'Odin', both: 'Just Go' },
  },
  hr: {
    title: 'Dva života, jedna vremenska os',
    lede: 'Odakle njih dvojica dolaze, redom. Obje su priče o kretanju prije nego što se osjećate spremnima — odatle tvrtki ime.',
    who: { berislav: 'Berislav', odin: 'Odin', both: 'Just Go' },
  },
}[locale];

const whoTone: Record<string, string> = {
  berislav: 'text-horizon-text border-horizon/35 bg-horizon-wash',
  odin: 'text-ridge border-mist/50 bg-mist/12',
  both: 'text-navy border-navy/25 bg-navy/5',
};
---

<section class="bg-snow">
  <div class="wrap section-y">
    <div class="max-w-[40rem]">
      <p class="eyebrow text-horizon-text mb-4">{t('label.milestones')}</p>
      <h2 class="text-h2 text-navy">{copy.title}</h2>
      <p class="mt-5 text-body-l text-ink-soft max-w-[52ch]">{copy.lede}</p>
    </div>

    <ol class="mt-14 relative">
      <!-- The spine -->
      <div
        class="absolute left-[4.25rem] sm:left-[5.5rem] top-2 bottom-2 w-px bg-rule hidden sm:block"
        aria-hidden="true"></div>

      {
        milestones.map((m) => (
          <li class="relative grid sm:grid-cols-[5.5rem_1fr] gap-x-8 gap-y-2 py-6 border-b border-rule-soft last:border-b-0">
            <div class="flex sm:block items-center gap-3">
              <span class="font-mono text-[0.95rem] font-medium tabular-nums text-navy tracking-[0.02em]">
                {m.year}
              </span>
              <span
                class:list={[
                  'inline-block sm:mt-2 font-mono text-[0.6rem] uppercase tracking-[0.1em] px-1.5 py-0.5 border',
                  whoTone[m.who],
                ]}
              >
                {copy.who[m.who]}
              </span>
            </div>
            <div class="sm:pl-6 relative">
              <span
                class="absolute -left-[1.55rem] top-[0.6rem] h-2 w-2 rounded-full bg-horizon hidden sm:block ring-4 ring-snow"
                aria-hidden="true"
              />
              <h3 class="font-display font-semibold text-h3 text-navy text-balance">{m.title[locale]}</h3>
              <p class="mt-2 text-body text-ink-soft max-w-[58ch] leading-relaxed">{m.body[locale]}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
