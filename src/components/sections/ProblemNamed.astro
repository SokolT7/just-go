---
import type { Locale } from '@/i18n/routes';

interface Props { locale: Locale; }
const { locale } = Astro.props;

/* Recognition before pitch. Three symptoms a visitor sees in their own
   business, written as sentences they would say themselves. */
const copy = {
  en: {
    eyebrow: 'Sound familiar?',
    title: 'Most sales problems are not strategy problems. They are starting problems.',
    lede:
      'The plan is usually fine. What is missing is the call nobody made, the price nobody raised, and the partnership nobody asked for.',
    items: [
      {
        title: 'The pipeline is full and nothing closes',
        body: 'Activity is high, conversion is not. Usually the qualification is generous and the hard question gets asked three meetings too late.',
      },
      {
        title: 'A new market is quietly eating the budget',
        body: 'You entered because it looked adjacent. Six months in, nobody can say which segment is actually working, or why.',
      },
      {
        title: 'Partners sign once and never renew',
        body: 'Getting the first yes was the easy part. Nobody owns the reporting, the follow-through, or the conversation twelve months later.',
      },
    ],
  },
  hr: {
    eyebrow: 'Zvuči poznato?',
    title: 'Većina prodajnih problema nisu problemi strategije. To su problemi početka.',
    lede:
      'Plan je najčešće u redu. Nedostaje poziv koji nitko nije obavio, cijena koju nitko nije podigao i partnerstvo koje nitko nije zatražio.',
    items: [
      {
        title: 'Lijevak je pun, a ništa se ne zatvara',
        body: 'Aktivnosti je puno, konverzije nema. Kvalifikacija je obično preblaga, a teško pitanje postavi se tri sastanka prekasno.',
      },
      {
        title: 'Novo tržište tiho jede budžet',
        body: 'Ušli ste jer je izgledalo blisko. Nakon šest mjeseci nitko ne zna koji segment zapravo radi ni zašto.',
      },
      {
        title: 'Partneri potpišu jednom i nikad se ne obnove',
        body: 'Prvo „da” bilo je lakši dio. Nitko ne vodi izvještavanje, praćenje ni razgovor dvanaest mjeseci kasnije.',
      },
    ],
  },
}[locale];
---

<section class="bg-snow">
  <div class="wrap section-y">
    <div class="max-w-[40rem]">
      <p class="eyebrow text-horizon-text mb-4">{copy.eyebrow}</p>
      <h2 class="text-h2 text-navy">{copy.title}</h2>
      <p class="mt-5 text-body-l text-ink-soft max-w-[54ch]">{copy.lede}</p>
    </div>

    <ul class="mt-14 grid gap-px bg-rule sm:grid-cols-2 lg:grid-cols-3 border border-rule">
      {
        copy.items.map((item) => (
          <li class="bg-snow p-7 lg:p-8">
            <h3 class="font-display font-semibold text-h3 text-navy text-balance">{item.title}</h3>
            <p class="mt-3 text-small text-ink-soft leading-relaxed">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
