---
import { Image } from 'astro:assets';
import heroImage from '@/assets/images/hero-road-porsche-v2.jpg';
import { path, type Locale } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import Button from '@/components/ui/Button.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
  Headline formula (PLAN, blueprint §02): [who you help] + [problem you solve]
  + [outcome]. Not a slogan.

  This is the LCP element on the most important page: eager, high priority and
  with explicit dimensions. The section fills the viewport, so the photograph is
  shown whole down to the fold instead of being clipped by a shorter container.
*/
const copy = {
  en: {
    kicker: 'Sales & business development · Zagreb, worldwide',
    h1a: 'Just go.',
    h1b: 'The rest is momentum.',
    lede:
      'We help founders and sales teams fix what is actually stopping the deal — the positioning, the process, and the conversations nobody is starting. Twenty-five years of doing it, not theorising about it.',
    secondary: 'See how we work',
    scroll: 'Scroll',
  },
  hr: {
    kicker: 'Prodaja i razvoj poslovanja · Zagreb, svijet',
    h1a: 'Samo kreni.',
    h1b: 'Ostalo je zalet.',
    lede:
      'Pomažemo osnivačima i prodajnim timovima riješiti ono što zaista koči posao — pozicioniranje, proces i razgovore koje nitko ne započinje. Dvadeset pet godina prakse, ne teorije.',
    secondary: 'Pogledajte kako radimo',
    scroll: 'Niže',
  },
}[locale];
---

<section class="hero-full relative flex flex-col bg-navy text-snow overflow-hidden">
  <!-- Photograph -->
  <div class="absolute inset-0">
    <!--
      Photograph by Fabrizio Coco, Unsplash (nieN2PuH_eY), edited to add the
      Porsche. The edit came out at 1264×842 and was upscaled 4x to 5056×3368
      (v2), so the ladder can run up to 2400px again.

      `width`/`height` are set explicitly because they also decide the fallback
      `src`. Left off, Astro falls back to the intrinsic 5056px — a multi-MB
      AVIF shipped as the LCP image's src. Capping at the top of the ladder
      keeps the fallback small, and the ratio here matches the source.
    -->
    <Image
      src={heroImage}
      alt=""
      widths={[640, 1024, 1600, 2400]}
      width={2400}
      height={1599}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      format="avif"
      quality={72}
      class="h-full w-full object-cover object-[58%_100%]"
    />
    <!--
      The crop is anchored on the car, which sits low (79–89% down) and right of
      centre (53–63% across). Pinned to the bottom edge, wide viewports trim sky
      instead of the car; at 58% across, tall phone crops still keep it whole.

      Two overlays: a vertical wash so the headline sits on the clean sky, and a
      left-weighted gradient so text stays legible on narrow viewports where the
      crop shifts. The bottom stop is kept light so the car is not lost in it.
    -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-navy/80 via-navy/28 to-navy/50"
      aria-hidden="true"></div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-navy/75 via-navy/12 to-transparent"
      aria-hidden="true"></div>
  </div>

  <!-- Content -->
  <div class="hero-body relative wrap flex flex-1 flex-col justify-center py-12 sm:py-16">
    <div class="max-w-[46rem]">
      <p class="eyebrow text-horizon">{copy.kicker}</p>

      <h1 class="hero-title mt-5 sm:mt-6 text-display-xl text-snow">
        {copy.h1a}<br />
        <span class="text-mist-light">{copy.h1b}</span>
      </h1>

      <div class="hero-rule mt-6 sm:mt-7 h-[2px] w-14 bg-horizon" aria-hidden="true"></div>

      <p class="hero-lede mt-5 sm:mt-7 max-w-[52ch] text-body sm:text-body-l text-mist-light">
        {copy.lede}
      </p>

      <div class="hero-actions mt-8 sm:mt-10 flex flex-col xs:flex-row flex-wrap items-stretch xs:items-center gap-4">
        <Button href={path('contact', locale)} variant="primary" size="lg">
          {t('cta.primary')}
        </Button>
        <Button href={path('services', locale)} variant="onDark" size="lg">
          {copy.secondary}
        </Button>
      </div>

      <p class="hero-promise mt-5 sm:mt-6 font-mono text-label uppercase tracking-[0.12em] text-mist/80">
        {t('promise.sameDay')}
      </p>
    </div>
  </div>

  <!--
    A full-screen hero hides the fact that there is anything below it, so the
    page needs to say so. Decorative only — the content it points at is reachable
    by scrolling or by the skip link.
  -->
  <div class="hero-cue-wrap relative wrap pb-7 sm:pb-9 shrink-0" aria-hidden="true">
    <div class="flex items-center gap-3">
      <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-mist/80">
        {copy.scroll}
      </span>
      <span class="block h-8 w-px overflow-hidden bg-white/15">
        <span class="hero-cue-line block h-full w-full bg-horizon"></span>
      </span>
    </div>
  </div>
</section>
