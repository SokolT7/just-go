---
import { dayInTheLife } from '@/data/dayInTheLife';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/routes';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
  The signature personalization moment. Horizontal, scroll-snapping timeline on
  wide viewports; a plain vertical stack on mobile where horizontal scroll is a
  usability tax. The timestamps are a real sequence, so the ordering carries
  information rather than decorating the section.
*/
const copy = {
  en: {
    title: 'One working day, roughly',
    lede: 'Not a stock photo of a boardroom. This is what the work actually looks like from the inside — the ordinary hours where deals are either moved or quietly lost.',
  },
  hr: {
    title: 'Otprilike jedan radni dan',
    lede: 'Ne fotografija sale za sastanke iz banke slika. Ovako posao izgleda iznutra — obični sati u kojima se poslovi ili pomiču ili tiho gube.',
  },
}[locale];
---

<section class="bg-navy text-snow overflow-hidden">
  <div class="wrap section-y">
    <div class="max-w-[40rem]">
      <p class="eyebrow text-horizon mb-4">{t('label.day')}</p>
      <h2 class="text-h2 text-snow">{copy.title}</h2>
      <p class="mt-5 text-body-l text-mist max-w-[52ch]">{copy.lede}</p>
    </div>
  </div>

  <!-- Wide: horizontal rail with snap. Narrow: vertical stack. -->
  <div class="mt-12">
    <ol
      class="flex flex-col gap-px bg-white/10
             md:flex-row md:gap-0 md:overflow-x-auto md:snap-x md:snap-mandatory
             md:[scrollbar-width:thin] md:[scrollbar-color:var(--color-ridge)_transparent]"
    >
      {
        dayInTheLife.map((entry, i) => (
          <li
            class:list={[
              'bg-navy p-7 lg:p-9 md:snap-start md:shrink-0',
              'md:w-[19rem] lg:w-[21rem] md:border-r md:border-white/10',
              i === 0 ? 'md:pl-[max(1.5rem,calc((100vw-78rem)/2+2.5rem))]' : '',
            ]}
          >
            <p class="font-mono text-[0.95rem] font-medium tabular-nums text-horizon tracking-[0.04em]">
              {entry.time}
            </p>
            <div class="mt-4 mb-4 h-px w-full bg-white/12" aria-hidden="true" />
            <h3 class="font-display font-semibold text-[1.05rem] text-snow text-balance">
              {entry.title[locale]}
            </h3>
            <p class="mt-3 text-small text-mist leading-relaxed">{entry.body[locale]}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
