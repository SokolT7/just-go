---
import { path, type Locale } from '@/i18n/routes';
import Button from '@/components/ui/Button.astro';
import { Image } from 'astro:assets';
import beroFloor from '@/assets/images/people/berislav-floor.jpg';

interface Props { locale: Locale; }
const { locale } = Astro.props;

/*
  Replaces the "a day at Just Go" strip. After meeting the two founders, the
  next question a prospect actually has is "so what happens if I get in touch?"
  — answering it here, before the proof section, removes the hesitation that
  kills high-ticket enquiries.

  The Services page carries the same three steps in more detail; this is the
  preview, laid out differently so it does not read as a copy-paste.
*/
const copy = {
  en: {
    eyebrow: 'Working together',
    title: 'It starts with a thirty-minute call',
    lede: 'No procurement theatre, no discovery deck. Three steps between reading this page and having someone senior working on the problem.',
    steps: [
      {
        n: '01',
        t: 'A call',
        b: 'You describe the situation. We ask the questions that usually get skipped. Thirty minutes, no charge, no pitch — and if we are not the right fit, we will tell you on that call rather than sell you something.',
        meta: '30 minutes · no charge',
      },
      {
        n: '02',
        t: 'A written proposal',
        b: 'Scope, price, timeline, and what success looks like — on one page. You will know exactly what you are buying before anyone signs anything, and the fee does not move once it is agreed.',
        meta: 'Within a week',
      },
      {
        n: '03',
        t: 'We start',
        b: 'Usually inside two weeks. You work with Berislav directly for the whole engagement. If a programme needs more hands, we name the specialists before you sign, not after.',
        meta: 'Typically 2 weeks later',
      },
    ],
    cta: 'Start with the call',
    photoAlt: 'Berislav Sokač in conversation with two people on a conference floor',
    photoCaption: 'Where most engagements actually begin',
    note: 'Most engagements run 6 weeks to 9 months. We will tell you which on the first call.',
  },
  hr: {
    eyebrow: 'Kako surađujemo',
    title: 'Počinje pozivom od trideset minuta',
    lede: 'Bez nabavne birokracije i bez uvodnih prezentacija. Tri koraka između čitanja ove stranice i trenutka kad netko iskusan radi na vašem problemu.',
    steps: [
      {
        n: '01',
        t: 'Poziv',
        b: 'Vi opišete situaciju. Mi postavimo pitanja koja se obično preskoče. Trideset minuta, bez naplate i bez prodaje — a ako nismo pravi izbor, reći ćemo vam na tom pozivu umjesto da vam nešto prodamo.',
        meta: '30 minuta · bez naplate',
      },
      {
        n: '02',
        t: 'Pisana ponuda',
        b: 'Opseg, cijena, rokovi i kako izgleda uspjeh — na jednoj stranici. Znat ćete točno što kupujete prije nego itko išta potpiše, a cijena se nakon dogovora ne mijenja.',
        meta: 'Unutar tjedan dana',
      },
      {
        n: '03',
        t: 'Krećemo',
        b: 'Obično unutar dva tjedna. Radite izravno s Berislavom kroz cijeli angažman. Ako programu treba više ruku, specijaliste imenujemo prije potpisa, a ne poslije.',
        meta: 'Obično nakon 2 tjedna',
      },
    ],
    cta: 'Počnite pozivom',
    photoAlt: 'Berislav Sokač u razgovoru s dvoje ljudi na konferenciji',
    photoCaption: 'Ovdje većina angažmana zapravo počinje',
    note: 'Većina angažmana traje od 6 tjedana do 9 mjeseci. Na prvom pozivu reći ćemo vam koliko.',
  },
}[locale];
---

<section class="bg-navy text-snow">
  <div class="wrap section-y">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="lg:self-start">
        <p class="eyebrow text-horizon mb-4">{copy.eyebrow}</p>
        <h2 class="text-h2 text-snow max-w-[16ch]">{copy.title}</h2>
        <p class="mt-5 text-body-l text-mist max-w-[44ch]">{copy.lede}</p>
        <Button href={path('contact', locale)} variant="primary" size="lg" class="mt-8">
          {copy.cta}
        </Button>
        <p class="mt-6 text-small text-mist/80 max-w-[38ch]">{copy.note}</p>

        <figure class="mt-10 hidden lg:block">
          <Image
            src={beroFloor}
            alt={copy.photoAlt}
            widths={[360, 540, 720]}
            sizes="22rem"
            loading="lazy"
            decoding="async"
            format="avif"
            quality={78}
            class="w-full max-w-[22rem] h-auto border border-white/15"
          />
          <figcaption class="mt-3 font-mono text-label uppercase tracking-[0.1em] text-mist/80">
            {copy.photoCaption}
          </figcaption>
        </figure>
      </div>

      <ol class="relative">
        <!-- The spine connecting the three steps. -->
        <div
          class="absolute left-[1.15rem] top-3 bottom-3 w-px bg-white/15 hidden sm:block"
          aria-hidden="true"></div>

        {
          copy.steps.map((step) => (
            <li class="relative grid sm:grid-cols-[2.5rem_1fr] gap-x-6 gap-y-2 pb-9 last:pb-0">
              <span
                class="relative z-10 grid h-9 w-9 shrink-0 place-items-center bg-horizon text-navy font-mono text-[0.7rem] font-medium tabular-nums"
                aria-hidden="true"
              >
                {step.n}
              </span>
              <div class="sm:pt-1">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <h3 class="font-display font-bold text-[1.25rem] tracking-[-0.02em] text-snow">
                    {step.t}
                  </h3>
                  <span class="font-mono text-label uppercase tracking-[0.1em] text-mist/80">
                    {step.meta}
                  </span>
                </div>
                <p class="mt-3 text-body text-mist leading-relaxed max-w-[52ch]">{step.b}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
