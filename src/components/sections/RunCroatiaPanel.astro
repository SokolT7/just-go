---
import type { Locale } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
  Run Croatia as living proof-of-work. Verifiable and substantial — it carries
  the proof surfaces while client testimonials are being collected (PLAN §7).
*/
const copy = {
  en: {
    title: 'We build things, we do not only advise on them',
    body: [
      'In 2015 Berislav co-founded Run Croatia alongside a corporate sales career. Ten years later it has delivered more than 130 events, and Zagreb Advent Run has become Europe’s largest festive costume run.',
      'Every sponsor on those start lines was a cold conversation once. That is not a metaphor for the consulting work — it is the same work, done on our own budget and our own risk.',
    ],
    figures: [
      { value: '130+', label: 'events in ten years' },
      { value: '10', label: 'editions of Zagreb Advent Run' },
      { value: '#1', label: 'Advent race of its kind in Europe' },
    ],
    link: 'runcroatia.hr',
  },
  hr: {
    title: 'Gradimo, a ne samo savjetujemo',
    body: [
      'Berislav je 2015. uz korporativnu prodajnu karijeru suosnovao Run Croatiu. Deset godina kasnije iza nje je više od 130 događaja, a Zagreb Advent Run postao je najveća kostimirana blagdanska utrka u Europi.',
      'Svaki sponzor na tim startnim linijama jednom je bio hladan kontakt. To nije metafora za konzalting — to je isti posao, na vlastiti budžet i vlastiti rizik.',
    ],
    figures: [
      { value: '130+', label: 'događaja u deset godina' },
      { value: '10', label: 'izdanja Zagreb Advent Runa' },
      { value: '#1', label: 'adventska utrka te vrste u Europi' },
    ],
    link: 'runcroatia.hr',
  },
}[locale];
---

<section class="bg-surface border-y border-rule">
  <div class="wrap section-y">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.85fr] lg:gap-20 lg:items-start">
      <div class="max-w-[46rem] reveal">
        <p class="eyebrow text-horizon-text mb-4">{t('label.proof')}</p>
        <h2 class="text-h2 text-navy">{copy.title}</h2>
        {copy.body.map((para) => <p class="mt-5 text-body-l text-ink-soft max-w-[56ch]">{para}</p>)}
        <a
          href="http://runcroatia.hr/"
          rel="noopener"
          class="mt-7 inline-flex items-center gap-2 font-display text-[0.95rem] font-semibold text-horizon-text underline underline-offset-4 decoration-1 hover:decoration-2"
        >
          {copy.link}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 9L9 3M9 3H4M9 3v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <dl class="border border-rule divide-y divide-rule reveal">
        {
          copy.figures.map((fig) => (
            <div class="flex items-baseline gap-5 p-6">
              <dd class="font-display font-bold text-[2.1rem] leading-none tracking-[-0.04em] text-navy tabular-nums shrink-0 w-[4.5rem]">
                {fig.value}
              </dd>
              <dt class="text-small text-ink-soft leading-snug">{fig.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
